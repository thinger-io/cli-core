{
    "name": "@thinger-io/cli-core",
    "version": "0.1.1",
    "description": "Shared core of the Thinger.io CLIs and their MCP servers: API client, auth, profiles, generic commands and MCP tools",
    "type": "module",
    "exports": {
        "./*": "./lib/*.js"
    },
    "files": [
        "lib",
        "CHANGELOG.md",
        "LICENSE",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinger-io/cli-core.git"
    },
    "bugs": "https://github.com/thinger-io/cli-core/issues",
    "homepage": "https://github.com/thinger-io/cli-core#readme",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc",
        "test": "node --test 'tests/**/*.test.js'"
    },
    "keywords": [
        "cli",
        "iot",
        "thinger",
        "mcp"
    ],
    "author": "Thinger.io",
    "license": "MIT",
    "dependencies": {
        "@inquirer/prompts": "^8.4.1",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "axios": "^1.10.0",
        "chalk": "^5.4.1",
        "commander": "^14.0.0",
        "open": "^11.0.0",
        "ora": "^9.3.0"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.6.0",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.5.0",
        "prettier": "^3.8.3",
        "typescript": "^6.0.2"
    }
}
